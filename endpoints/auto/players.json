{
    "getAll": {
        "description": "Gets all entries from 'players'",
        "route": "/players",
        "method": "GET",
        "sql": "SELECT * FROM players",
        "auth_required": false,
        "allowed_roles": [
            "*"
        ]
    },
    "getById": {
        "description": "Gets an entry from 'players' by its primary key",
        "route": "/players/$peopleId",
        "method": "GET",
        "sql": "SELECT * FROM players WHERE peopleId = $peopleId",
        "auth_required": false,
        "allowed_roles": [
            "*"
        ]
    },
    "create": {
        "description": "Creates a new entry in 'players'",
        "route": "/players",
        "method": "POST",
        "sql": "INSERT INTO players (peopleId, ranking) VALUES ($peopleId, $ranking)",
        "request_body_params": [
            "peopleId",
            "ranking"
        ],
        "auth_required": false,
        "allowed_roles": [
            "*"
        ]
    },
    "update": {
        "description": "Updates an existing entry in 'players' by its primary key",
        "route": "/players/$peopleId",
        "method": "PUT",
        "sql": "UPDATE players SET peopleId = $peopleId, ranking = $ranking WHERE peopleId = $peopleId",
        "request_body_params": [
            "peopleId",
            "ranking"
        ],
        "auth_required": false,
        "allowed_roles": [
            "*"
        ]
    },
    "delete": {
        "description": "Deletes an existing entry in 'players' by its primary key",
        "route": "/players/$peopleId",
        "method": "DELETE",
        "sql": "DELETE FROM players WHERE peopleId = $peopleId",
        "auth_required": false,
        "allowed_roles": [
            "*"
        ]
    }
}